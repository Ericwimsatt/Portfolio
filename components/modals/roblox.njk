{% from "components/modals/_base.njk" import modal %}
{% call modal("modal-roblox", "Roblox experience") %}
<div class="chat-app">
  <div class="chat-header">
    <div class="chat-avatar">
      <svg viewBox="0 0 40 40" width="38" height="38">
        <g transform="rotate(5, 20, 20)">
          <path fill-rule="evenodd" fill="#111" d="M2,2 H38 V38 H2 Z M16,16 H24 V24 H16 Z"/>
        </g>
      </svg>
    </div>
    <div>
      <div class="chat-name">Roblox</div>
      <div class="chat-sub">Software Engineer, Growth &middot; Jul 2021 &ndash; Jul 2024</div>
    </div>
  </div>
  <div class="chat-messages">
    <div class="chat-system">Stack: React &middot; Lua &middot; C++ &middot; Java</div>

    <div class="chat-row chat-left">
      <div class="chat-bubble chat-bubble-l">
        <div class="chat-label">Performance</div>
        <strong>Halved</strong> time-to-interactive on startup by batching and removing network requests on the critical path.
      </div>
    </div>

    <div class="chat-row chat-left">
      <div class="chat-bubble chat-bubble-l">
        <div class="chat-label">Platform Stability</div>
        Added retry mechanisms at common failure points &mdash; resulting in a <strong>+2% improvement</strong> in app startup success rate.
      </div>
    </div>
    <div class="chat-img-row chat-left">
      <div class="chat-img-wrap">
        <img src="static/roblox-error.webp" alt="Roblox error screen" class="chat-img">
      </div>
    </div>

    <div class="chat-row chat-left">
      <div class="chat-bubble chat-bubble-l">
        <div class="chat-label">Growth &amp; Matchmaking</div>
        Improved game-join success rate by <strong>+4%</strong> by identifying failure cases, redesigning UX routes, and adding in-game feedback toasts to reduce user confusion during loading.
      </div>
    </div>
    <div class="chat-img-row chat-left">
      <div class="chat-img-wrap">
        <img src="static/social_toast.png" alt="Social toast notification" class="chat-img">
      </div>
    </div>

    <div class="chat-row chat-right">
      <div class="chat-bubble chat-bubble-r">
        wow
      </div>
    </div>
  </div>
</div>
{% endcall %}

    <div class="lp-hole"></div><div class="lp-hole"></div>
  </div>
  <div class="lp-content">
    <h2 class="lp-title">Projects</h2>

    <div class="proj-section">
      <h3 class="proj-cat">Supporting Vibe Coders</h3>
      <ul class="proj-lines">
        <li><a href="https://github.com/Ericwimsatt/bulk-refactor" target="_blank" rel="noopener"><span class="proj-icon" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M14 2a4 4 0 0 0-3.9 4.9L4.5 12.5a1.5 1.5 0 0 0 2.1 2.1l5.6-5.6A4 4 0 1 0 14 2zm0 6a2 2 0 1 1 0-4 2 2 0 0 1 0 4z" stroke="#060301" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="proj-text"><strong>bulk-refactor</strong> &mdash; Toolkit to bring existing codebases up to current conventions. Combines deterministic refactors and agents to complete tasks <em>(Python)</em></span></a></li>
        <li><a href="https://github.com/Ericwimsatt/pseudo" target="_blank" rel="noopener"><span class="proj-icon" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><ellipse cx="10" cy="10" rx="9" ry="5.5" stroke="#3b2a18" stroke-width="1.2"/><circle cx="10" cy="10" r="2.5" stroke="#3b2a18" stroke-width="1.2"/><circle cx="10" cy="10" r="1" fill="#3b2a18"/></svg></span><span class="proj-text"><strong>pseudo</strong> &mdash; Plain-English code viewer.  Gives less-technical users a deeper understanding of their codebases <em>(React / Typescript / Electron)</em></span></a></li>
      </ul>
    </div>

    <div class="proj-section">
      <h3 class="proj-cat">Fun</h3>

      <ul class="proj-lines">
        <li><a href="https://github.com/Ericwimsatt/rockets" target="_blank" rel="noopener"><span class="proj-icon" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M10 2C7 2 5 6 5 9l2 2 1-1 1 4 1-4 1 1 2-2c0-3-2-7-5-7z" stroke="#060301" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/><path d="M7 11l-2 3h3m8-3l-3 3h3" stroke="#060301" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/><circle cx="10" cy="7" r="1.2" fill="#060301"/></svg></span><span class="proj-text"><strong>rockets</strong> &mdash; Extends the Treys library to support complex simulations of poker hands and table games<em>(Python)</em></span></a></li>
        <li><a href="https://github.com/Ericwimsatt/gamble" target="_blank" rel="noopener"><span class="proj-icon" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="2" y="3" width="11" height="15" rx="2" stroke="#1d3557" stroke-width="1.3"/><rect x="7" y="2" width="11" height="15" rx="2" stroke="#1d3557" stroke-width="1.3"/><text x="10.5" y="12" font-size="7" text-anchor="middle" fill="#e63946" font-family="serif" font-weight="bold">♠</text></svg></span><span class="proj-text"><strong>collusion</strong> &mdash; Strategy testing for poker and other table games <em>(Python)</em></span></a></li>
